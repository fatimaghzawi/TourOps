# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Docker Compose overrides this to mongodb://mongo:27017
# DJANGO_SQLITE_PATH=/app/data/db.sqlite3

# MongoDB — primary application database
# Local default:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=tourops

# Demo staff (python manage.py seed_demo_user)
DEMO_OWNER_EMAIL=owner@tourops.local
DEMO_OWNER_PASSWORD=changeme
DEMO_AGENT_EMAIL=agent@tourops.local
DEMO_AGENT_PASSWORD=changeme
DEMO_ACCOUNTANT_EMAIL=accountant@tourops.local
DEMO_ACCOUNTANT_PASSWORD=changeme

# Optional: Atlas example
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority

# --- Production (never ship demo passwords or DJANGO_DEBUG=true) ---
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<long random string>
# DJANGO_SECURE=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_ALLOWED_HOSTS=app.example.com
# DJANGO_LOG_LEVEL=INFO
# GUNICORN_WORKERS=3
# docker compose up --build -d
